# Performance Optimization Settings for Windows

# Disable expensive animations for lower-end systems
VITE_DISABLE_EXPENSIVE_ANIMATIONS=true

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Reduce initial bundle size
VITE_LAZY_LOAD_HEAVY_COMPONENTS=true

# Optimize for Windows performance
VITE_WINDOWS_PERFORMANCE_MODE=true